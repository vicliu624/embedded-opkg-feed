* text=auto
*.sh text eol=lf
*.env text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.tsv text eol=lf
packages/libhwy/cpu0-scalar.cmake text eol=lf
packages/libjxl/cpu0-emulated.cmake text eol=lf

# Signed repository artifacts must retain their exact published bytes on every
# host; checkout and archive conversion would invalidate detached signatures.
site/feed/**/Packages -text
site/feed/**/*.asc -text
site/feed/**/*.gz -text
site/feed/**/*.ipk -text

# Embedded third-party patches use their own leading marker characters and may
# carry tabs or an intentionally blank added line that must be retained for
# `patch` to reproduce the upstream hunk.  Do not evaluate those patch-format
# bytes as source-code indentation during the repository whitespace gate.
packages/**/patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
support/**/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
tests/fixtures/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
packages/libmariadb/public-compression-header.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
packages/gstreamer-plugins-base/ogg-push-segment-seqnum.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
# The final context line is an upstream blank line, part of the unified hunk.
packages/gstreamer-plugins-bad/vp9-checked-bit-reader.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Recovery provenance binds the tool bytes across Windows/Linux checkouts.
scripts/restore-sqlite-development.py text eol=lf
scripts/build-staging-receipt.py text eol=lf
