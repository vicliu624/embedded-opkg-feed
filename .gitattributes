* text=auto
*.sh text eol=lf
*.env text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Signed repository artifacts must retain their exact published bytes on every
# host; checkout and archive conversion would invalidate detached signatures.
site/feed/**/Packages -text
site/feed/**/*.asc -text
site/feed/**/*.gz -text
site/feed/**/*.ipk -text

# Embedded third-party patches use their own leading marker characters and may
# carry tabs or an intentionally blank added line that must be retained for
# `patch` to reproduce the upstream hunk.  Do not evaluate those patch-format
# bytes as source-code indentation during the repository whitespace gate.
packages/**/patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
support/**/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
