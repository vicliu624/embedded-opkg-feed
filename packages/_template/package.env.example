# Copy this file to packages/<your-package>/package.env.
# Community packages should use: <github-handle>-<application>.

PACKAGE='your-github-handle-my-app'
VERSION='0.1.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='Your Name <you@example.com>'
DESCRIPTION='Short application description'
SUPPORTED_PLATFORMS='tdvp-k230-r1'

# Optional application-package dependencies only. Do not place the platform ABI
# marker here; the build script injects it from the chosen platform manifest.
PACKAGE_DEPENDS=''
