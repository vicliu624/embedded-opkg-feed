# Copy this file to packages/<your-package>/package.env.
# Generic upstream libraries keep their upstream package names. Community
# applications should use: <github-handle>-<application>.

PACKAGE='your-github-handle-my-app'
VERSION='0.1.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='Your Name <you@example.com>'
DESCRIPTION='Short application description'
SUPPORTED_PLATFORMS='tdvp-k230-r1'

# `application` packages may not write /usr/lib.  `shared-library` packages
# are maintained runtime components, may install only audited SONAME-bearing
# files beneath /usr/lib, and are checked against the base image plus every
# other package in the release.
PACKAGE_KIND='application'

# Appears in the public catalogue. Examples: libraries, utils, desktop, games.
# PACKAGE_SECTION=''

# The immutable catalogue revisions in which this recipe may be published.
# Existing r1 artifacts never change; a newly introduced package starts at r2.
PACKAGE_RELEASES='r2'

# Runtime dependencies are serialized into the opkg control file.  Do not put
# the platform ABI marker here; the build script injects it from the chosen
# platform manifest.
PACKAGE_DEPENDS=''

# Build-only package names establish the deterministic build order and expose
# their headers/.pc/CMake files through TDVP_FEED_STAGING_ROOT.  They do not
# replace PACKAGE_DEPENDS; a runtime relationship must still be declared.
PACKAGE_BUILD_DEPENDS=''
