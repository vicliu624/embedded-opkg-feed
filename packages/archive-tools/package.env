PACKAGE='archive-tools'
VERSION='1.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU and 7-Zip archive commands without replacing firmware BusyBox'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r9 r10'
PACKAGE_DEPENDS='libbz2 (= 1.0.8-1), liblzma (= 5.6.4-1), libzstd (= 1.5.7-1)'
PACKAGE_BUILD_DEPENDS='libbz2 liblzma libzstd'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://buildroot.org/'
SOURCE_REVISION='2025.02.1'
