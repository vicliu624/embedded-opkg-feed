[Desktop Entry]
Type=Application
Name=Music Player
Name[zh_CN]=音乐播放器
Comment=Play local music and playlists
Comment[zh_CN]=播放本地音乐和播放列表
Exec=tdvp-audacious %U
Icon=audacious
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/ogg;audio/flac;audio/wav;audio/x-wav;audio/mp4;audio/x-m4a;application/ogg;application/x-mpegurl;audio/x-mpegurl;audio/x-scpls;
StartupNotify=true
