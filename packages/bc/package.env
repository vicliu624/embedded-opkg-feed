PACKAGE='bc'
VERSION='1.07.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU arbitrary-precision calculator exposed as tdvp-bc for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
# The actual GNU bc executable remains private to this IPK. The public
# tdvp-bc wrapper cannot replace a firmware /usr/bin/bc BusyBox applet.
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://www.gnu.org/software/bc/'
SOURCE_REVISION='1.07.1'
SOURCE_ARCHIVE='bc-1.07.1.tar.gz'
SOURCE_ARCHIVE_SHA256='62adfca89b0a1c0164c2cdca59ca210c1d44c3ffc46daf9931cf4942664cb02a'
