PACKAGE='ca-certificates'
VERSION='2025.02.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TLS trust store built from locked Debian ca-certificates source for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_BASE_OVERLAY='deny'

# Buildroot 2025.02.1's reviewed Debian-source package. The build hook verifies
# the same source version and archive digest against the locked Buildroot tree.
SOURCE_REPOSITORY='https://salsa.debian.org/debian/ca-certificates'
SOURCE_REVISION='20230311'
SOURCE_ARCHIVE='ca-certificates_20230311.tar.xz'
SOURCE_ARCHIVE_SHA256='83de934afa186e279d1ed08ea0d73f5cf43a6fbfb5f00874b6db3711c64576f3'
