PACKAGE='ffprobe'
VERSION='4.4.4-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='FFmpeg media metadata probe for the TDVP K230 feed'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='sound'
PACKAGE_RELEASES='r7 r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

# The command is rebuilt through the exact Buildroot package source locked by
# the TDVP firmware, while the feed payload contains only the missing ffprobe
# frontend. Existing /usr/bin/ffmpeg ownership stays with the base image.
SOURCE_REPOSITORY='https://ffmpeg.org/releases'
SOURCE_REVISION='ffmpeg-4.4.4.tar.xz sha256:e80b380d595c809060f66f96a5d849511ef4a76a26b76eacf5778b94c3570309'
BUILD_ENVIRONMENT='protected-tdvp-k230-buildroot-output'
