PACKAGE='gawk'
VERSION='5.3.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU awk interpreter for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libreadline (= 8.2-1)'
PACKAGE_BUILD_DEPENDS='libreadline'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://www.gnu.org/software/gawk/'
SOURCE_REVISION='5.3.1'
