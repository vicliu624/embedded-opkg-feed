PACKAGE='git'
VERSION='2.48.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Git distributed version control command-line client for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r9 r10'
PACKAGE_DEPENDS='git-runtime (= 2.48.1-1), ca-certificates (= 2025.02.1-1)'
PACKAGE_BUILD_DEPENDS='git-runtime'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/git/git'
SOURCE_REVISION='v2.48.1'
