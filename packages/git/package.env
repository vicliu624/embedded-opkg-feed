PACKAGE='git'
VERSION='2.48.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Git distributed version control command-line client for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r10'
# tdvp-k230-r1 owns the SSH client commands in its immutable base image.
# The source-built openssh-client candidate differs byte-for-byte (CI run
# 33901555917) and is therefore not an installable feed dependency.
PACKAGE_DEPENDS='git-runtime (= 2.48.1-1), ca-certificates (= 2025.02.1-1)'
PACKAGE_BUILD_DEPENDS='git-runtime'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://cdn.kernel.org/pub/software/scm/git/'
SOURCE_REVISION='2.48.1'
SOURCE_ARCHIVE='git-2.48.1.tar.xz'
SOURCE_ARCHIVE_SHA256='1c5d545f5dc1eb51e95d2c50d98fdf88b1a36ba1fa30e9ae5d5385c6024f82ad'
