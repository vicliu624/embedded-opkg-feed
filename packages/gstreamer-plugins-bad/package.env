PACKAGE='gstreamer-plugins-bad'
VERSION='1.28.7-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GStreamer bitstream parser libraries and portable media processing plugins'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='multimedia'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libgstreamer (= 1.28.7-1), gstreamer-plugins-base (>= 1.28.7-2)'
PACKAGE_BUILD_DEPENDS='libgstreamer gstreamer-plugins-base'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libglib-2.0-0'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc meson ninja pkg-config python3 tar xz patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
PACKAGE_GSTREAMER_FEATURES='adpcmdec adpcmenc aiff asfmux audiobuffersplit audiofxbad audiolatency audiomixmatrix autoconvert bayer closedcaption codectimestamper coloreffects debugutils fieldanalysis freeverb gaudieffects gdp geometrictransform id3tag insertbin inter interlace ivfparse ivtc jpegformat mpegdemux mpegpsmux mpegtsdemux mpegtsmux mxf netsim onvif pcapparse pnm proxy removesilence rist sdp segmentclip siren smooth speed subenc switchbin tensordecoders timecode unixfd videofilters videoframe_audiolevel videoparsers videosignal'
SOURCE_REPOSITORY='https://gitlab.freedesktop.org/gstreamer/gstreamer'
SOURCE_REVISION='1.28.7'
