PACKAGE='gstreamer-plugins-good'
VERSION='1.28.7-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GStreamer network streams, media containers, image and audio processing plugins'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='multimedia'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libgstreamer (= 1.28.7-1), gstreamer-plugins-base (>= 1.28.7-2), gstreamer-plugins-bad (>= 1.28.7-1)'
PACKAGE_BUILD_DEPENDS='libgstreamer gstreamer-plugins-base libvpx gstreamer-plugins-bad'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libglib-2.0-0 libjpeg-9 libpng16-16 libflac libcairo-2 libgdk-pixbuf-2.0-0 libpulse-0'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc meson ninja pkg-config python3 tar xz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
PACKAGE_GSTREAMER_FEATURES='alpha apetag audiofx audioparsers auparse autodetect avi cutter debugutils deinterlace dtmf effectv equalizer flv flx goom goom2k1 icydemux id3demux imagefreeze interleave isomp4 law level matroska monoscope multifile multipart replaygain rtp rtpmanager rtsp shapewipe smpte spectrum udp videobox videocrop videofilter videomixer wavenc wavparse xingmux y4m cairo flac gdk-pixbuf jpeg png pulse vpx'
SOURCE_REPOSITORY='https://gitlab.freedesktop.org/gstreamer/gstreamer'
SOURCE_REVISION='1.28.7'
