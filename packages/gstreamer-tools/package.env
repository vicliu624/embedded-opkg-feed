PACKAGE='gstreamer-tools'
VERSION='1.28.7-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GStreamer inspection, launch and typefind command tools'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='multimedia'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libgstreamer (= 1.28.7-1)'
