PACKAGE='htop'
VERSION='3.3.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Interactive process viewer for TDVP K230 terminals'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libncursesw (= 6.4-20230603-1), libcap-2 (= 2.73-1)'
PACKAGE_BUILD_DEPENDS='libncursesw libcap-2'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/htop-dev/htop'
SOURCE_REVISION='3.3.0'
