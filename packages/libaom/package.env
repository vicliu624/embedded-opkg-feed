PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE PATENTS AUTHORS third_party/fastfeat/LICENSE third_party/libyuv/LICENSE third_party/vector/LICENSE third_party/highway/LICENSE-BSD3'
SOURCE_REPOSITORY='https://aomedia.googlesource.com/aom'
SOURCE_REVISION='v3.13.3'
