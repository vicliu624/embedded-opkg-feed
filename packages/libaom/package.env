PACKAGE='libaom'
VERSION='3.13.3-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Scalar AV1 encoder and decoder shared library for image/media applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
