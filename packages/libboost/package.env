PACKAGE='libboost'
VERSION='1.82.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Boost common C++ shared libraries with ICU, Python and compression backends'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libpython3.13 (= 3.13.3-2)'
PACKAGE_BUILD_DEPENDS='libpython3.13 libicuuc libicui18n libicudata libicuio libbz2 liblzma libzstd'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libz'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc g++ make python3 tar bzip2 pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE_1_0.txt'
SOURCE_REPOSITORY='https://github.com/boostorg/boost'
SOURCE_REVISION='boost-1.82.0'
