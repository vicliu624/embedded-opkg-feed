PACKAGE='libcap-ng'
VERSION='0.9.6-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='POSIX capability manipulation shared library for TDVP CPU0'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc make pkg-config tar autoconf automake libtoolize autoreconf'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_AUTORECONF=1
PACKAGE_BOOTSTRAP_SCRIPT='autogen.sh'
PACKAGE_LICENSE_FILES='COPYING COPYING.LIB'
SOURCE_REPOSITORY='https://github.com/stevegrubb/libcap-ng'
SOURCE_REVISION='v0.9.6'
