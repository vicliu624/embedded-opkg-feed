PACKAGE='libcjson'
VERSION='1.7.19-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='cjson shared library and reusable development export for TDVP CPU0'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
