PACKAGE='libcurl-4'
VERSION='8.12.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='libcurl HTTPS transport shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='ca-certificates (= 2025.02.1-1), libssl-3 (= 3.4.1-1), libcrypto-3 (= 3.4.1-1), libzstd (= 1.5.7-1), libz (= 1.3.1-1), libatomic-1 (= 14.1.1-1)'
PACKAGE_BUILD_DEPENDS=''
# r10 owns the sole libcurl-4 runtime IPK. Its matching SDK supplies the
# development projection used by feed consumers, so libcurl is never rebuilt
# merely to recover headers, linker links, pkg-config data, or curl-config.
PACKAGE_SDK_DEVELOPMENT_FILES='usr/include/curl/curl.h usr/lib/pkgconfig/libcurl.pc usr/lib/libcurl.so usr/bin/curl-config'
PACKAGE_SOURCE_STAGING=0
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://github.com/curl/curl'
SOURCE_REVISION='curl-8_12_1'
SOURCE_ARCHIVE='curl-8.12.1.tar.xz'
SOURCE_ARCHIVE_SHA256='0341f1ed97a26c811abaebd37d62b833956792b7607ea3f15d001613c76de202'
