From: TDVP Device Team
Subject: [PATCH] Add relocatable shared-library CMake development export

--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,16 @@
+cmake_minimum_required(VERSION 3.16)
+project(fft2d VERSION 1.0 LANGUAGES C)
+include(GNUInstallDirs)
+foreach(name alloc fft4f2d fftsg fftsg2d fftsg3d shrtdct)
+  add_library(fft2d_${name} ${name}.c)
+  set_target_properties(fft2d_${name} PROPERTIES VERSION 1.0 SOVERSION 1)
+  target_include_directories(fft2d_${name} PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}> $<INSTALL_INTERFACE:include/fft2d>)
+  target_link_libraries(fft2d_${name} PUBLIC m)
+  install(TARGETS fft2d_${name} EXPORT fft2d-targets LIBRARY DESTINATION lib ARCHIVE DESTINATION lib)
+endforeach()
+target_link_libraries(fft2d_fft4f2d PUBLIC fft2d_alloc)
+target_link_libraries(fft2d_fftsg2d PUBLIC fft2d_fftsg fft2d_alloc)
+target_link_libraries(fft2d_fftsg3d PUBLIC fft2d_fftsg fft2d_alloc)
+file(GLOB headers "${CMAKE_CURRENT_SOURCE_DIR}/*.h")
+install(FILES ${headers} DESTINATION include/fft2d)
+install(EXPORT fft2d-targets FILE fft2d-config.cmake DESTINATION lib/cmake/fft2d)
