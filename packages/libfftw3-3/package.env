PACKAGE='libfftw3-3'
VERSION='3.3.10-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Double precision FFT and threaded FFT for TDVP CPU0 applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
