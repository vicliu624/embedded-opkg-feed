PACKAGE='libhdf5'
VERSION='2.2.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='HDF5 serial C/C++ and high-level libraries with deflate and SZIP encoding'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libaec'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config qemu-riscv64'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE'
SOURCE_REPOSITORY='https://github.com/HDFGroup/hdf5'
SOURCE_REVISION='2.2.0'
