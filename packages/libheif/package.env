PACKAGE='libheif'
VERSION='1.23.6-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='HEIF image library with HEVC, AV1, JPEG and JPEG 2000 codecs'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libde265 libx265 libaom libopenjp2 libopenjph libwebp-7'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
PACKAGE_REPRODUCIBLE_SOURCE_PATHS=1
SOURCE_REPOSITORY='https://github.com/strukturag/libheif'
SOURCE_REVISION='v1.23.6'
