PACKAGE='libidn2'
VERSION='2.3.8-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='IDNA2008 internationalized domain name shared library for TDVP CPU0'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
