PACKAGE_HOST_DEPENDS='gcc make pkg-config tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING COPYING.LESSERv3 COPYING.unicode COPYINGv2'
SOURCE_REPOSITORY='https://www.gnu.org/software/libidn/'
SOURCE_REVISION='2.3.8'
