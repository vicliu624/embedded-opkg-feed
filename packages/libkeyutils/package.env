PACKAGE='libkeyutils'
VERSION='1.6.3-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Linux kernel key management syscall wrapper library'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc make tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENCE.LGPL TDVP-COPYRIGHT-NOTICE'
SOURCE_REPOSITORY='https://kernel.googlesource.com/pub/scm/linux/kernel/git/dhowells/keyutils/'
SOURCE_REVISION='v1.6.3'
