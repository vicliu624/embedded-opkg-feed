PACKAGE='libkrb5'
VERSION='1.22.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='MIT Kerberos and GSSAPI shared libraries and development export'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
