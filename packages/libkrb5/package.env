PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='NOTICE README'
SOURCE_REPOSITORY='https://web.mit.edu/kerberos/'
SOURCE_REVISION='1.22.2'
