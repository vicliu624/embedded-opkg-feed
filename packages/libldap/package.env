PACKAGE='libldap'
VERSION='2.6.15-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='OpenLDAP LDAP/BER client shared libraries with OpenSSL and Cyrus SASL'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libsasl2'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc make patch tar pkg-config python3 qemu-riscv64 strings'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE COPYRIGHT'
SOURCE_REPOSITORY='https://www.openldap.org/software/'
SOURCE_REVISION='OPENLDAP_REL_ENG_2_6_15'
