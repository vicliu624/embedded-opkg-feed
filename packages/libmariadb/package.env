PACKAGE='libmariadb'
VERSION='3.4.11-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='MariaDB and MySQL client library with TLS and authentication plugins'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libkrb5 libzstd'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libssl-3 libcrypto-3 libz libcurl-4'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_REPRODUCIBLE_SOURCE_PATHS=1
PACKAGE_LICENSE_FILES='COPYING.LIB'
SOURCE_REPOSITORY='https://github.com/mariadb-corporation/mariadb-connector-c'
SOURCE_REVISION='v3.4.11'
