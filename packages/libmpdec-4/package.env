PACKAGE='libmpdec-4'
VERSION='4.0.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='mpdecimal arbitrary-precision decimal shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

# Buildroot 2025.02.1's reviewed mpdecimal package source.
SOURCE_REPOSITORY='https://www.bytereef.org/mpdecimal/'
SOURCE_REVISION='4.0.0'
SOURCE_ARCHIVE='mpdecimal-4.0.0.tar.gz'
