PACKAGE='libncursesw'
VERSION='6.4-20230603-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ncurses wide-character shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
# The released platform SDK provides this development interface. Consumers
# validate these exact files before their source build, while the target-runtime
# catalogue remains the sole final libncursesw IPK provider.
PACKAGE_SDK_DEVELOPMENT_FILES='usr/include/curses.h usr/lib/pkgconfig/ncursesw.pc usr/lib/libncursesw.so'
PACKAGE_SOURCE_STAGING=0
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/ThomasDickey/ncurses-snapshots'
SOURCE_REVISION='v6_4_20230603'
