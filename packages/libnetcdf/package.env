PACKAGE='libnetcdf'
VERSION='4.10.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='NetCDF scientific dataset library with HDF5, DAP and NCZarr'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libhdf5 libbz2 libzstd'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYRIGHT'
SOURCE_REPOSITORY='https://github.com/Unidata/netcdf-c'
SOURCE_REVISION='v4.10.1'
