PACKAGE='libnode'
VERSION='22.23.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Node.js v22 shared embedding runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libcares (= 1.34.2-1), libuv (= 1.50.0-1), libnghttp2 (= 1.64.0-1), libicui18n (= 73.2-1)'
PACKAGE_BUILD_DEPENDS='libcares libuv libnghttp2 libicui18n libicuio'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/nodejs/node'
