PACKAGE='libnuma'
VERSION='2.0.19-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='NUMA userspace compatibility library; kernel policy availability is queried at runtime'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc make tar pkg-config python3 grep perl'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE.LGPL2.1 LICENSE.GPL2 TDVP-COPYRIGHT-NOTICE'
SOURCE_REPOSITORY='https://github.com/numactl/numactl'
SOURCE_REVISION='v2.0.19'
