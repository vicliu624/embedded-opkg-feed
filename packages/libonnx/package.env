PACKAGE='libonnx'
VERSION='1.17.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ONNX model serialization, checking and shape inference shared libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libprotobuf'
PACKAGE_BUILD_DEPENDS='libprotobuf'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/onnx/onnx'
SOURCE_REVISION='v1.17.0'
