PACKAGE='libonnxruntime'
VERSION='1.21.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ONNX Runtime CPU execution provider for TDVP Linux'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libonnx, libprotobuf, libabseil-cpp, libre2, libdate-tz, libflatbuffers'
PACKAGE_BUILD_DEPENDS='libonnx libprotobuf libabseil-cpp libre2 libdate-tz libflatbuffers eigen-dev boost-mp11-dev nlohmann-json-dev microsoft-gsl-dev safeint-dev'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/microsoft/onnxruntime'
SOURCE_REVISION='v1.21.0'
