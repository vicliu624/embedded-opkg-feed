PACKAGE='libopencv4'
VERSION='4.10.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='opencv4 image processing runtime for TDVP CPU0'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libtiff-6, libwebp-7'
PACKAGE_BUILD_DEPENDS='libtiff-6 libwebp-7'
PACKAGE_HOST_DEPENDS='cmake ninja make gcc tar pkg-config python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://sources.buildroot.net/opencv4'
SOURCE_REVISION='4.10.0'
