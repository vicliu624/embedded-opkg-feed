PACKAGE='libopenexr'
VERSION='3.5.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='OpenEXR HDR image shared libraries with external compression providers'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libimath libopenjph libdeflate libzstd'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE.md'
SOURCE_REPOSITORY='https://github.com/AcademySoftwareFoundation/openexr'
SOURCE_REVISION='v3.5.2'
