PACKAGE='libpcap'
VERSION='1.10.5-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Linux packet capture and BPF filter compilation library'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='make gcc tar pkg-config flex bison'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://www.tcpdump.org/release/libpcap-1.10.5.tar.gz'
SOURCE_REVISION='1.10.5'
