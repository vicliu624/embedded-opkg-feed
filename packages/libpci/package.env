PACKAGE='libpci'
VERSION='3.15.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='PCI access library with Linux backends and locked PCI identifier database'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc make tar pkg-config python3 gzip grep sed'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING TDVP-COPYRIGHT-NOTICE TDVP-PCI-ID-NOTICE'
SOURCE_REPOSITORY='https://git.kernel.org/pub/scm/utils/pciutils/pciutils.git'
SOURCE_REVISION='v3.15.0'
