PACKAGE='libpcre2-8'
VERSION='10.44-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='PCRE2 8-bit shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_SDK_DEVELOPMENT_FILES='usr/include/pcre2.h usr/lib/pkgconfig/libpcre2-8.pc usr/lib/libpcre2-8.so usr/bin/pcre2-config'
PACKAGE_PLATFORM_RUNTIME_PROVIDER='libpcre2-8-0'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/PCRE2Project/pcre2'
SOURCE_REVISION='pcre2-10.44'
