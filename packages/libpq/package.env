PACKAGE='libpq'
VERSION='18.6-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='PostgreSQL client library with TLS, GSSAPI and LDAP support'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libkrb5 libldap'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libssl-3 libcrypto-3'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc make tar bzip2 perl pkg-config python3 bison flex'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYRIGHT'
SOURCE_REPOSITORY='https://git.postgresql.org/git/postgresql.git'
SOURCE_REVISION='REL_18_6'
