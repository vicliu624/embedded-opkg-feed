PACKAGE='libprotobuf'
VERSION='29.3-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Protobuf serialization runtime and reusable development files'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libabseil-cpp'
PACKAGE_BUILD_DEPENDS='libabseil-cpp'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libz'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/protocolbuffers/protobuf'
SOURCE_REVISION='v29.3'
