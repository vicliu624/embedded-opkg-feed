PACKAGE='libpsl'
VERSION='0.23.3-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Public suffix list shared library with built-in data for TDVP CPU0'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libidn2 (= 2.3.8-1)'
PACKAGE_BUILD_DEPENDS='libidn2'
PACKAGE_HOST_DEPENDS='gcc make pkg-config tar python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_LICENSE_FILES='COPYING LICENSE src/LICENSE.chromium list/public_suffix_list.dat'
SOURCE_REPOSITORY='https://github.com/rockdaboot/libpsl'
SOURCE_REVISION='0.23.3'
