PACKAGE='libreadline'
VERSION='8.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU readline shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libncursesw-6 (= 2025.02.1-1)'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libncursesw-6'
PACKAGE_SDK_DEVELOPMENT_FILES='usr/include/readline/readline.h usr/lib/pkgconfig/readline.pc usr/lib/libreadline.so'
PACKAGE_PLATFORM_RUNTIME_PROVIDER='libreadline-8'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://tiswww.case.edu/php/chet/readline/rltop.html'
SOURCE_REVISION='8.2'
