PACKAGE='libsasl2'
VERSION='2.1.28-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Cyrus SASL authentication library and SCRAM/GSSAPI mechanism modules'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libkrb5 libgdbm'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='autoconf automake libtoolize gcc make patch tar pkg-config python3 qemu-riscv64 strings'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
SOURCE_REPOSITORY='https://github.com/cyrusimap/cyrus-sasl'
SOURCE_REVISION='cyrus-sasl-2.1.28'
