PACKAGE='libselinux'
VERSION='3.11-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SELinux userspace interface library with PCRE2 label matching'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
# load_policy.c uses dlopen: the ELF NEEDED inventory cannot infer this edge.
PACKAGE_DEPENDS='libsepol (= 3.11-2)'
PACKAGE_BUILD_DEPENDS='libsepol'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc make tar pkg-config python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE TDVP-COPYRIGHT-NOTICE'
SOURCE_REPOSITORY='https://github.com/SELinuxProject/selinux'
SOURCE_REVISION='3.11'
