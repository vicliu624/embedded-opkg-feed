PACKAGE='libsoup3'
VERSION='3.6.6-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GLib asynchronous HTTP client/server, HTTP/2 and WebSocket library'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='glib-networking'
PACKAGE_BUILD_DEPENDS='libnghttp2 libpsl libsqlite3-0 libbrotli libkrb5'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libglib-2.0-0 libz'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='gcc meson ninja pkg-config python3 tar xz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
SOURCE_REPOSITORY='https://gitlab.gnome.org/GNOME/libsoup'
SOURCE_REVISION='3.6.6'
