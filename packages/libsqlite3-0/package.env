PACKAGE='libsqlite3-0'
VERSION='3.48.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SQLite SQL database shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
