PACKAGE='libssh'
VERSION='0.12.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SSH client and server library with SFTP, GSSAPI and compression'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS='libkrb5'
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libssl-3 libz'
PACKAGE_USE_FEED_DEVELOPMENT=1
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_REPRODUCIBLE_SOURCE_PATHS=1
PACKAGE_LICENSE_FILES='COPYING BSD AUTHORS'
SOURCE_REPOSITORY='https://git.libssh.org/projects/libssh.git'
SOURCE_REVISION='libssh-0.12.2'
