PACKAGE='libssl-3'
VERSION='3.4.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='OpenSSL TLS shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libcrypto-3 (= 3.4.1-1)'
PACKAGE_BUILD_DEPENDS='libcrypto-3, libz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://github.com/openssl/openssl'
SOURCE_REVISION='openssl-3.4.1'
SOURCE_ARCHIVE='openssl-3.4.1.tar.gz'
SOURCE_ARCHIVE_SHA256='002a2d6b30b58bf4bea46c43bdd96365aaf8daa6c428782aa4feee06da197df3'
