PACKAGE='libtag'
VERSION='2.3.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TagLib audio metadata reader/writer with C and C++ interfaces'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libz'
PACKAGE_HOST_DEPENDS='gcc cmake ninja tar pkg-config python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_REPRODUCIBLE_SOURCE_PATHS=1
PACKAGE_LICENSE_FILES='COPYING.LGPL COPYING.MPL AUTHORS 3rdparty/utfcpp/LICENSE'
SOURCE_REPOSITORY='https://github.com/taglib/taglib'
SOURCE_REVISION='v2.3.2'
