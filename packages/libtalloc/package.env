PACKAGE='libtalloc'
VERSION='2.5.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Standalone talloc C runtime and development library'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc make python3 pkg-config tar qemu-riscv64'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='LICENSE GPL-3.0.txt TDVP-COPYRIGHT-NOTICE'
SOURCE_REPOSITORY='https://www.samba.org/ftp/talloc/'
SOURCE_REVISION='2.5.0'
