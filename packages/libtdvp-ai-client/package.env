PACKAGE='libtdvp-ai-client'
VERSION='0.1.0-2'
PACKAGE_LICENSE='MIT'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Nonblocking CPU0 client for the published CPU1 AI2D, FFT and pinned KWS protocol'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='gcc'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/vicliu624/embedded-opkg-feed'
SOURCE_REVISION='feed-recipe-revision'
SOURCE_LOCK_EXEMPT_REASON='First-party C client sources are versioned with the feed recipe; protocol headers come from the ABI-matched published SDK. No external source tree is imported.'
