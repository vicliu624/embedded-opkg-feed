PACKAGE='libtensorflow-lite'
VERSION='2.18.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TensorFlow Lite C++ CPU inference shared runtime for TDVP Linux'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libabseil-cpp, libfarmhash, libfft2d, libflatbuffers, libcpuinfo'
PACKAGE_BUILD_DEPENDS='libabseil-cpp libfarmhash libfft2d libflatbuffers libprotobuf libcpuinfo eigen-dev gemmlowp-dev ml-dtypes-dev ruy-dev'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config sed find realpath sha256sum'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/tensorflow/tensorflow'
SOURCE_REVISION='v2.18.0'
