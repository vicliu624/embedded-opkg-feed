PACKAGE='libtheora'
VERSION='1.2.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Theora video encoder, decoder and compatibility shared libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_SDK_DEVELOPMENT_DEPENDS='libogg-0'
PACKAGE_HOST_DEPENDS='gcc make tar xz pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
PACKAGE_LICENSE_FILES='COPYING'
SOURCE_REPOSITORY='https://gitlab.xiph.org/xiph/theora'
SOURCE_REVISION='v1.2.0'
