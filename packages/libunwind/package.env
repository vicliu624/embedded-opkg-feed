PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/libunwind/libunwind'
SOURCE_REVISION='v1.8.3'
