PACKAGE='libz'
VERSION='1.3.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='zlib shared compression runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_SDK_DEVELOPMENT_FILES='usr/include/zlib.h usr/lib/pkgconfig/zlib.pc usr/lib/libz.so'
# The r10 image owns this ABI under the target-derived canonical name.  Keep
# the source lock for provenance; consumers use libz-1 through the SDK table.
PACKAGE_PLATFORM_RUNTIME_PROVIDER='libz-1'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://www.zlib.net/'
SOURCE_REVISION='1.3.1'
