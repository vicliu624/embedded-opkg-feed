PACKAGE='libzmq-5'
VERSION='4.3.5-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ZeroMQ asynchronous messaging library with libsodium CURVE security'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='libsodium (>= 1.0.22-1)'
PACKAGE_BUILD_DEPENDS='libsodium'
PACKAGE_HOST_DEPENDS='cmake ninja gcc pkg-config tar python3'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/zeromq/libzmq'
SOURCE_REVISION='v4.3.5'
