PACKAGE='libzstd'
VERSION='1.5.7-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Zstandard shared runtime library for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_SECTION='libraries'
PACKAGE_RELEASES='r9 r10'
PACKAGE_DEPENDS=''
# The matched K230 Buildroot configuration builds zstd without XZ/LZMA support.
# Keep this empty unless the selected SDK configuration proves a build-time
# dependency is required; the source lock remains the reproducibility record.
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/facebook/zstd'
SOURCE_REVISION='v1.5.7'
