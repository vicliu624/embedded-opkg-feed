PACKAGE='logrotate'
VERSION='3.22.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Private-namespaced log rotation command for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libpopt (= 1.19-1)'
PACKAGE_BUILD_DEPENDS='libpopt'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://github.com/logrotate/logrotate'
SOURCE_REVISION='3.22.0'
SOURCE_ARCHIVE='logrotate-3.22.0.tar.xz'
SOURCE_ARCHIVE_SHA256='42b4080ee99c9fb6a7d12d8e787637d057a635194e25971997eebbe8d5e57618'
