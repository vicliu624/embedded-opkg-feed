PACKAGE='lz4'
VERSION='1.10.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Private-namespaced LZ4 command suite for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/lz4/lz4'
SOURCE_REVISION='v1.10.0'
FORMAT_VERSION='1'
SOURCE_TYPE='buildroot-derived'
UPSTREAM_NAME='LZ4'
UPSTREAM_LICENSE='BSD-2-Clause (library), GPL-2.0+ (programs)'
UPSTREAM_VERSION='1.10.0'
UPSTREAM_REVISION='3815d578c5759fa824322ea3d95ad51b55ab888e'
SOURCE_SNAPSHOT='https://gitlab.com/buildroot.org/buildroot/-/blob/3815d578c5759fa824322ea3d95ad51b55ab888e/package/lz4/lz4.mk'
SOURCE_SELECTION_REASON='LZ4 1.10.0 is the current upstream release and exactly matches Buildroot 2025.02.1. The candidate exposes only private command ELFs and tdvp-prefixed frontends; it does not replace a firmware command or publish a shared-runtime ABI.'
NON_PLATFORM_BUILD_INPUTS='Buildroot 2025.02.1 lz4.mk, lz4.hash and Config.in. The private transaction enables only the LZ4 command feature and overrides LZ4_MAKE_OPTS with BUILD_SHARED=no, so the build-time static implementation can be linked into the command suite. The generic helper copies only lz4, lz4c, unlz4 and lz4cat beneath /usr/libexec/tdvp-lz4; it never copies liblz4.so, liblz4.a, headers, pkg-config metadata or the original public command paths. The actual RISC-V ELF closure remains subject to Actions runtime-closure verification.'
SECURITY_STATUS='The official HTTPS tag archive SHA-256 is rechecked before the private offline transaction. CI builds and audits command ELFs only: it never invokes lz4, supplies content, compresses data, or extracts data. LZ4 framing and checksums do not authenticate content; candidate admission additionally requires locked cache, RISC-V ELF, runtime-closure and deny-overlay gates.'
VERIFIED_BY='TDVP source-lock verifier plus Buildroot 2025.02.1 lz4 package hash and a streamed official GitHub tag archive SHA-256 check'
VERIFIED_AT='2026-09-06'
VERIFICATION_REFERENCE='https://raw.githubusercontent.com/buildroot/buildroot/2025.02.1/package/lz4/lz4.hash'
SOURCE_ARTIFACT_1_URL='https://github.com/lz4/lz4/archive/refs/tags/v1.10.0.tar.gz'
SOURCE_ARTIFACT_1_FILE='lz4-1.10.0.tar.gz'
SOURCE_ARTIFACT_1_SHA256='537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b'
