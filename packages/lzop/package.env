PACKAGE='lzop'
VERSION='1.04-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Private-namespaced LZOP command for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://www.lzop.org/; https://www.oberhumer.com/opensource/lzo/'
SOURCE_REVISION='lzop-1.04; lzo-2.10'
FORMAT_VERSION='1'
SOURCE_TYPE='buildroot-derived'
UPSTREAM_NAME='lzop with LZO'
UPSTREAM_LICENSE='GPL-2.0+'
UPSTREAM_VERSION='1.04; 2.10'
UPSTREAM_REVISION='3815d578c5759fa824322ea3d95ad51b55ab888e'
SOURCE_SNAPSHOT='https://gitlab.com/buildroot.org/buildroot/-/blob/3815d578c5759fa824322ea3d95ad51b55ab888e/package/lzop/lzop.mk'
SOURCE_SELECTION_REASON='lzop 1.04 and LZO 2.10 are the current upstream releases and exactly match Buildroot 2025.02.1. The candidate exposes only a private command ELF and a tdvp-prefixed frontend; it does not replace a firmware command or publish a shared-runtime ABI.'
NON_PLATFORM_BUILD_INPUTS='Buildroot 2025.02.1 lzop/lzo mk, hash and Config.in files. The private transaction forces LZO_CONF_OPTS=-DENABLE_SHARED=OFF -DENABLE_STATIC=ON so liblzo2 is a build-time static implementation only. The generic helper copies only lzop below /usr/libexec/tdvp-lzop; it never copies liblzo2.so, liblzo2.a, headers, pkg-config metadata or the original public command path. The actual RISC-V ELF closure remains subject to Actions runtime-closure verification.'
SECURITY_STATUS='Both official HTTPS archives are SHA-256 rechecked before the private offline transaction. CI builds and audits the command ELF only: it never invokes lzop, supplies content, compresses data, or extracts data. LZO/LZOP frames and checksums do not authenticate content; candidate admission additionally requires locked cache, RISC-V ELF, runtime-closure and deny-overlay gates.'
VERIFIED_BY='TDVP source-lock verifier plus Buildroot 2025.02.1 lzo/lzop package hashes and streamed official HTTPS archive SHA-256 checks'
VERIFIED_AT='2026-09-06'
VERIFICATION_REFERENCE='https://raw.githubusercontent.com/buildroot/buildroot/2025.02.1/package/lzop/lzop.hash'
