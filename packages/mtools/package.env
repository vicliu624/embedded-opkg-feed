PACKAGE='mtools'
VERSION='4.0.47-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU FAT/MS-DOS media utilities isolated behind tdvp-mtools command frontends'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='utils'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
# All source commands remain under /usr/libexec/tdvp-mtools and only
# tdvp-mtools-* wrappers are public, so a firmware-owned command cannot be
# replaced by this candidate.
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://www.gnu.org/software/mtools/'
SOURCE_REVISION='4.0.47'
