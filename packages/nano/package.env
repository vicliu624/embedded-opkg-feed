PACKAGE='nano'
VERSION='8.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Small terminal text editor for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='editors'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libncursesw (= 6.4-20230603-1)'
PACKAGE_BUILD_DEPENDS='libncursesw'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://www.nano-editor.org/'
SOURCE_REVISION='8.2'
