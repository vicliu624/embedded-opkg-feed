PACKAGE='net-tools'
VERSION='2.10-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Private-namespaced legacy network inspection tools for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='net'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/ecki/net-tools; https://sourceforge.net/projects/net-tools/'
SOURCE_REVISION='net-tools-2.10'
FORMAT_VERSION='1'
SOURCE_TYPE='buildroot-derived'
UPSTREAM_NAME='net-tools'
UPSTREAM_LICENSE='GPL-2.0+'
UPSTREAM_VERSION='2.10'
UPSTREAM_REVISION='3815d578c5759fa824322ea3d95ad51b55ab888e'
SOURCE_SNAPSHOT='https://gitlab.com/buildroot.org/buildroot/-/blob/3815d578c5759fa824322ea3d95ad51b55ab888e/package/net-tools/net-tools.mk'
SOURCE_SELECTION_REASON='net-tools 2.10 and its archive SHA-256 exactly match the fixed Buildroot 2025.02.1 recipe. This command-only candidate exposes legacy network diagnostics through distinct tdvp-* names and never replaces BusyBox paths or publishes a shared-runtime ABI.'
NON_PLATFORM_BUILD_INPUTS='Buildroot 2025.02.1 net-tools mk, hash and Config.in files are retained only as reviewed cross-build logic. The private transaction seeds net-tools-2.10.tar.xz only from the SHA-256-locked source cache, then extracts only selected command ELF files below /usr/libexec/tdvp-net-tools and generated tdvp-* frontends. No ordinary network command path, configuration file, service, header, static archive, pkg-config metadata or shared library enters the IPK.'
SECURITY_STATUS='The official SourceForge archive is SHA-256 rechecked before the private offline transaction. These are legacy network utilities: CI builds and audits ELF metadata only, never invokes a command, reads interface state, supplies an interface/address/route/device value, changes network configuration, opens a network connection, or enables a service. Candidate admission still requires locked cache, RISC-V ELF, runtime-closure and deny-overlay gates; any device networking test needs separate explicit authorization.'
VERIFIED_BY='TDVP source-lock verifier plus Buildroot 2025.02.1 net-tools package-hash and upstream repository review'
VERIFIED_AT='2026-09-06'
VERIFICATION_REFERENCE='https://raw.githubusercontent.com/buildroot/buildroot/2025.02.1/package/net-tools/net-tools.hash'
