PACKAGE='openssh-client'
VERSION='9.9p2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='OpenSSH client, file-transfer, and key-agent tools for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='net'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libssl-3 (= 3.4.1-1), libcrypto-3 (= 3.4.1-1), libz (= 1.3.1-1)'
PACKAGE_BUILD_DEPENDS='libssl-3 libcrypto-3 libz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/'
SOURCE_REVISION='9.9p2'
SOURCE_ARCHIVE='openssh-9.9p2.tar.gz'
SOURCE_ARCHIVE_SHA256='91aadb603e08cc285eddf965e1199d02585fa94d994d6cae5b41e1721e215673'
