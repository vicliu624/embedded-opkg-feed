PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/pkgconf/pkgconf'
SOURCE_REVISION='pkgconf-2.3.0'
