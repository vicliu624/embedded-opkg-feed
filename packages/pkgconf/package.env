PACKAGE='pkgconf'
VERSION='2.3.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='pkgconf and pkg-config metadata resolver for TDVP K230 development'
