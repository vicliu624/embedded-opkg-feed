PACKAGE='python3-cffi'
VERSION='2.1.1-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='cffi Python interface for TDVP audio and native application libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), python3-pycparser (= 3.0-1), libffi-8'
PACKAGE_BUILD_DEPENDS='libpython3.13'
PACKAGE_HOST_DEPENDS='python3 tar gcc pkg-config'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_PYTHON_NATIVE=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://pypi.org/project/cffi/'
SOURCE_REVISION='2.1.1'
