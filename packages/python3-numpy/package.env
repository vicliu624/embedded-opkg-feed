PACKAGE='python3-numpy'
VERSION='2.2.6-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='NumPy numerical arrays for the TDVP Python 3.13 runtime'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), libopenblas'
PACKAGE_BUILD_DEPENDS='libpython3.13 libopenblas'
PACKAGE_HOST_DEPENDS='meson ninja cython python3 pkg-config tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/numpy/numpy'
SOURCE_REVISION='v2.2.6'
