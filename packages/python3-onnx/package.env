PACKAGE='python3-onnx'
VERSION='1.17.0-3'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ONNX Python model creation and checking using public ONNX libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), libonnx (= 1.17.0-2), python3-numpy, python3-protobuf (= 5.29.3-2), python3-typing-extensions'
PACKAGE_BUILD_DEPENDS='libonnx libpython3.13 pybind11-dev'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/onnx/onnx'
SOURCE_REVISION='v1.17.0'
