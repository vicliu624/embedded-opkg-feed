PACKAGE='python3-onnxruntime'
VERSION='1.21.0-3'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='ONNX Runtime Python CPU inference API for TDVP'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), libonnxruntime (= 1.21.0-1), python3-onnx (= 1.17.0-3), python3-numpy, python3-protobuf (= 5.29.3-2), python3-flatbuffers (= 24.12.23-1), python3-packaging, python3-coloredlogs, python3-sympy (= 1.14.0-1)'
PACKAGE_BUILD_DEPENDS='libonnxruntime libpython3.13 python3-numpy pybind11-dev'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/microsoft/onnxruntime'
SOURCE_REVISION='v1.21.0'
