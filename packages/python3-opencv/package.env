PACKAGE='python3-opencv'
VERSION='4.10.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='OpenCV Python extension using independently owned TDVP OpenCV libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), python3-numpy, libopencv4'
PACKAGE_BUILD_DEPENDS='python3-numpy libopencv4'
PACKAGE_HOST_DEPENDS='python3 pkg-config tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/opencv/opencv'
SOURCE_REVISION='4.10.0'
