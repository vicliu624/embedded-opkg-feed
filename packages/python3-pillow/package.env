PACKAGE='python3-pillow'
VERSION='11.2.1-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Pillow JPEG, PNG, TIFF and WebP image processing for TDVP Python 3.13'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), libtiff-6, libwebp-7'
PACKAGE_BUILD_DEPENDS='libpython3.13 libtiff-6 libwebp-7'
PACKAGE_HOST_DEPENDS='python3 pkg-config tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/python-pillow/Pillow'
SOURCE_REVISION='11.2.1'
