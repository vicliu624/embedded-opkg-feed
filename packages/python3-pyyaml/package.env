PACKAGE='python3-pyyaml'
VERSION='6.0.3-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='PyYAML Python library for TDVP network and configuration applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), libyaml-0-2'
PACKAGE_BUILD_DEPENDS='libpython3.13 libyaml-0-2'
PACKAGE_HOST_DEPENDS='python3 tar gcc cython'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_PYTHON_NATIVE=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://pypi.org/project/PyYAML/'
SOURCE_REVISION='6.0.3'
