PACKAGE='python3-requests'
VERSION='2.34.2-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='requests Python library for TDVP network and configuration applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3-urllib3 (= 2.8.0-1), python3-idna (= 3.20-1), python3-charset-normalizer (= 3.5.2-1), python3-certifi (= 2026.7.22-1), python3-pysocks (= 1.7.1-1)'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='python3 tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_PYTHON_NATIVE=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://pypi.org/project/requests/'
SOURCE_REVISION='2.34.2'
