PACKAGE='python3-scipy'
VERSION='1.15.3-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SciPy scientific computing and signal processing for TDVP Python 3.13'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), python3-numpy (>= 2.2.6-2), python3-numpy (<< 2.5~), libopenblas'
PACKAGE_BUILD_DEPENDS='python3-numpy libopenblas'
PACKAGE_HOST_DEPENDS='meson ninja cython python3 pkg-config tar pybind11-config pythran patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/scipy/scipy'
SOURCE_REVISION='v1.15.3'
