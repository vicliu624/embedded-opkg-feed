PACKAGE='python3-sounddevice'
VERSION='0.5.6-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='sounddevice Python interface for TDVP audio and native application libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3-cffi (= 2.1.1-2), python3-numpy, libportaudio'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='python3 tar patch'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_PYTHON_NATIVE=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://pypi.org/project/sounddevice/'
SOURCE_REVISION='0.5.6'
