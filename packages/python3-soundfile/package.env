PACKAGE='python3-soundfile'
VERSION='0.14.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='soundfile Python interface for TDVP audio and native application libraries'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3-cffi (= 2.1.1-2), python3-numpy, python3-typing-extensions, libsndfile-1'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_HOST_DEPENDS='python3 tar'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_PYTHON_NATIVE=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://pypi.org/project/soundfile/'
SOURCE_REVISION='0.14.0'
