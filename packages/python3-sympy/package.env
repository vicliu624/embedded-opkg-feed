PACKAGE='python3-sympy'
VERSION='1.14.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='sympy mathematical Python library for TDVP inference and scientific applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
