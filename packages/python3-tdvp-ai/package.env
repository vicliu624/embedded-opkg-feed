PACKAGE='python3-tdvp-ai'
VERSION='0.1.0-2'
PACKAGE_LICENSE='MIT'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Synchronous and asyncio Python client for the published CPU1 AI protocol'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), libtdvp-ai-client'
PACKAGE_BUILD_DEPENDS='libtdvp-ai-client'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_LOCK_EXEMPT_REASON='First-party Python protocol bindings and diagnostics are versioned in this feed repository and use the independently built C client; no external source archive is imported.'
