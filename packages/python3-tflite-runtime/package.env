PACKAGE='python3-tflite-runtime'
VERSION='2.18.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TensorFlow Lite Python Interpreter API using the public CPU inference runtime'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='runtime'
PACKAGE_SECTION='languages'
PACKAGE_RELEASES='r11'
PACKAGE_DEPENDS='python3 (>= 3.13.3-2), python3 (<< 3.14~), python3-numpy (>= 2.2.6-2), python3-numpy (<< 3~), libtensorflow-lite (= 2.18.0-1), libabseil-cpp'
PACKAGE_BUILD_DEPENDS='libtensorflow-lite libpython3.13 python3-numpy libabseil-cpp pybind11-dev'
PACKAGE_HOST_DEPENDS='cmake ninja gcc tar pkg-config python3 patch find sha256sum sed realpath'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_PYTHON_NATIVE=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/tensorflow/tensorflow'
SOURCE_REVISION='v2.18.0'
