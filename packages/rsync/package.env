PACKAGE='rsync'
VERSION='3.4.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Rsync file synchronization command for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='net'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libpopt (= 1.19-1), libz (= 1.3.1-1)'
PACKAGE_BUILD_DEPENDS='libpopt libz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://rsync.samba.org/'
SOURCE_REVISION='3.4.1'
SOURCE_ARCHIVE='rsync-3.4.1.tar.gz'
SOURCE_ARCHIVE_SHA256='2924bcb3a1ed8b551fc101f740b9f0fe0a202b115027647cf69850d65fd88c52'
