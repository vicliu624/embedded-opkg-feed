PACKAGE='sdl2-ttf'
VERSION='2.22.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SDL_ttf runtime library for ABI-matched TDVP K230 applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_RELEASES='r3 r4 r5 r6 r7 r8'
PACKAGE_DEPENDS='sdl2 (= 2.30.11-2)'
PACKAGE_BUILD_DEPENDS='sdl2'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://github.com/libsdl-org/SDL_ttf.git'
SOURCE_REVISION='4a318f8dfaa1bb6f10e0c5e54052e25d3c7f3440'
