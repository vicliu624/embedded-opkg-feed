PACKAGE='sdl2'
VERSION='2.30.11-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SDL 2 runtime library for ABI-matched TDVP K230 applications'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='shared-library'
PACKAGE_RELEASES='r3 r4 r5 r6 r7 r8 r9 r10'
PACKAGE_DEPENDS=''
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://github.com/libsdl-org/SDL.git'
SOURCE_REVISION='fa24d868ac2f8fd558e4e914c9863411245db8fd'

# r3 changes the dependency graph only.  Reuse the signed r2 binary payload
# verbatim instead of recompiling SDL2; its immutable SHA-256 is part of this
# reviewed source contract.
REUSE_IPK_URL='https://vicliu624.github.io/embedded-opkg-feed/feed/tdvp-k230-br2025.02.1-glibc2.33-rv64-lp64d-k6.6.36-r1/r2/riscv64/sdl2_2.30.11-1_riscv64.ipk'
REUSE_IPK_SHA256='8d57706e1f4f24dd0502007898e9ae7a0e26b7f4375c31f58d89f13db83efe01'
