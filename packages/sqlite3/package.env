PACKAGE='sqlite3'
VERSION='3.48.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='SQLite interactive SQL database command-line shell for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='libsqlite3-0 (= 3.48.0-1), libreadline (= 8.2-1), libncursesw (= 6.4-20230603-1)'
PACKAGE_BUILD_DEPENDS='libsqlite3-0 libreadline libncursesw'
# libsqlite3-0 is a normal source-built build dependency, so build-all
# processes it first and it stages precisely /usr/bin/sqlite3 in this private
# transaction root. PACKAGE_STAGE_BUILD_DEPENDS is intentionally not used:
# that field is reserved for a target-derived deferred runtime provider.
PACKAGE_AUTO_RUNTIME_DEPENDS=1
# A target-owned sqlite3 command is never silently replaced. If the matched
# base already owns this path, build-ipk rejects this source-built leaf.
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://www.sqlite.org/'
SOURCE_REVISION='3.48.0'
SOURCE_ARCHIVE='sqlite-autoconf-3480000.tar.gz'
SOURCE_ARCHIVE_SHA256='ac992f7fca3989de7ed1fe99c16363f848794c8c32a158dafd4eb927a2e02fd5'
