PACKAGE='tdvp-ai-tools'
VERSION='0.1.0-2'
PACKAGE_LICENSE='MIT'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Command-line diagnostics for the CPU1 AI service'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
