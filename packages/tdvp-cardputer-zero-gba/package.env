PACKAGE='tdvp-cardputer-zero-gba'
VERSION='0.1.0-8'
PACKAGE_ARCH='riscv64'
MAINTAINER='Vic Li <vicliu624@users.noreply.github.com>'
DESCRIPTION='Game Boy Advance emulator frontend for the TDVP K230 landscape display'
SUPPORTED_PLATFORMS='tdvp-k230-r1'

# The package is built from this public, immutable upstream revision. The
# build hook verifies its Git origin, clean working tree, and exact HEAD before
# producing any payload; a sibling directory alone is not sufficient.
SOURCE_REPOSITORY='https://github.com/vicliu624/cardputer-zero-gameboy-emulator'
SOURCE_REVISION='444f01029845ff5867ccbe2ef7836b2bcdfc3318'
BUILD_ENVIRONMENT='protected-tdvp-k230-sdk'

# The feed tool injects the exact tdvp-platform-abi dependency from the platform
# manifest. The runtime links only against base-firmware components from the
# selected SDK/sysroot, so no additional opkg package name is guessed here.
PACKAGE_DEPENDS='tdvp-menu-games (= 1.0.0-1)'
