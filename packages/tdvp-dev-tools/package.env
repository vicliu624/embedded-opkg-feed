PACKAGE='tdvp-dev-tools'
VERSION='1.0-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TDVP K230 source-control, archive, editor, GitHub CLI, and Python development starter set'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r9'
PACKAGE_DEPENDS='archive-tools (= 1.0-1), git (= 2.48.1-1), gh (= 2.98.0-1), python3 (= 3.13.3-1), vim (= 9.1.0145-1)'
PACKAGE_BUILD_DEPENDS='archive-tools git gh python3 vim'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/vicliu624/embedded-opkg-feed'
SOURCE_REVISION='r9-development-catalogue'
