PACKAGE_DEPENDS='sdl2 (= 2.30.11-1), sdl2-ttf (= 2.22.0-1), libmgba (= 0.10.5-1), tdvp-base-runtime, tdvp-base-desktop, tdvp-base-audio'
PACKAGE_BUILD_DEPENDS='sdl2 sdl2-ttf libmgba'

SOURCE_REPOSITORY='https://github.com/vicliu624/cardputer-zero-gameboy-emulator'
