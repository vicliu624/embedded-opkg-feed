PACKAGE='tdvp-gba'
VERSION='0.2.3-4'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='Game Boy Advance emulator frontend for the TDVP K230 landscape desktop'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_RELEASES='r3 r4 r5 r6 r7 r8 r9 r10'
PACKAGE_DEPENDS='sdl2 (= 2.30.11-3), sdl2-ttf (= 2.22.0-3), libmgba (= 0.10.5-1)'
# These development prefixes are needed only in the release-local staging
# sysroot. They do not add a second runtime dependency beyond PACKAGE_DEPENDS.
PACKAGE_BUILD_DEPENDS='sdl2 libmgba'
PACKAGE_AUTO_RUNTIME_DEPENDS=1

SOURCE_REPOSITORY='https://github.com/vicliu624/cardputer-zero-gameboy-emulator'
SOURCE_REVISION='4c82b09e1bf042d0709c26ed6c4e5098a283a908'
