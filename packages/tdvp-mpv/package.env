PACKAGE='tdvp-mpv'
VERSION='0.35.1-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='MPV media player leaf application for the composable TDVP K230 feed'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_RELEASES='r3 r4 r5 r6 r7 r8'
PACKAGE_DEPENDS='ca-certificates (= 2025.02.1-1), tdvp-runtime-data (= 2025.02.1-1)'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1

# mpv is already built in the locked current image.  This recipe packages that
# exact executable rather than rebuilding FFmpeg, libass, and the renderer.
# PACKAGE_BASE_OVERLAY makes any mismatch against the target a hard error.
PACKAGE_BASE_OVERLAY='identical'
SOURCE_REPOSITORY='https://github.com/mpv-player/mpv'
SOURCE_REVISION='v0.35.1'
