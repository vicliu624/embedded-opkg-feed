PACKAGE='tdvp-netsurf'
VERSION='3.10-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='NetSurf GTK3 web browser for the ABI-matched TDVP K230 desktop'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_RELEASES='r3 r4 r5 r6'

# NetSurf is supplied by the locked Buildroot 2025.02.1 package source.  The
# build hook checks this checksum against Buildroot's own package hash before
# compiling, so a feed release never silently substitutes a host download.
SOURCE_ARCHIVE='netsurf-all-3.10.tar.gz'
SOURCE_ARCHIVE_SHA256='495adf6b6614ce36fca6c605f7c321f9cb4a3df838043158122678ce2b3325b7'
BUILDROOT_VERSION='2025.02.1'
BUILD_ENVIRONMENT='protected-tdvp-k230-buildroot-output'

# scripts/build-ipk.sh injects the exact tdvp-platform-abi dependency and,
# using the generated runtime owner map, derives exact versioned dependencies for its
# GTK3, Wayland, TLS, HTTP, image, font, and GLib direct ELF closure.  The
# browser never bundles or silently borrows those generic runtimes.
PACKAGE_DEPENDS='glib-networking (= 2025.02.1-1), ca-certificates (= 2025.02.1-1), gtk3-data (= 2025.02.1-1), gdk-pixbuf-loaders (= 2025.02.1-1), shared-mime-info (= 2025.02.1-1), adwaita-icon-theme (= 2025.02.1-1)'
PACKAGE_AUTO_RUNTIME_DEPENDS=1

# r6 broadens the independently owned base-runtime catalogue with the reusable
# libutf8proc runtime. The immutable, content-addressed r3 NetSurf payload is
# rebuilt only into a new IPK control archive by build-ipk.sh, so no
# FFmpeg/WebKit-like rebuild is needed merely to publish an equivalent leaf
# against the r6 dependency graph.
REUSE_IPK_URL='https://vicliu624.github.io/embedded-opkg-feed/feed/tdvp-k230-br2025.02.1-glibc2.33-rv64-lp64d-k6.6.36-r1/r3/riscv64/tdvp-netsurf_3.10-1_riscv64.ipk'
REUSE_IPK_SHA256='cc81f57d105d7c531efa0cafa66a7c3cd921d7fd4047ef1349ca5339a4bb0d5c'
