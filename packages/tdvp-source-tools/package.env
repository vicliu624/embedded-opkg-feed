PACKAGE='tdvp-source-tools'
VERSION='1.6-4'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='TDVP K230 text, transfer, search, JSON, and source-maintenance tool profile'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='devel'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='tree (= 2.1.1-1), less (= 661-1), file (= 5.45-1), which (= 2.21-1), wget (= 1.25.0-2), dos2unix (= 7.5.2-1), jq (= 1.7.1-1), grep (= 3.11-1), sed (= 4.9-1), findutils (= 4.10.0-1), gawk (= 5.3.1-2)'
PACKAGE_BUILD_DEPENDS='tree less file which wget dos2unix jq grep sed findutils gawk'
PACKAGE_AUTO_RUNTIME_DEPENDS=0
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/vicliu624/embedded-opkg-feed'
SOURCE_REVISION='r10-source-tools-profile-with-tdvp-wget-and-tdvp-awk'
SOURCE_LOCK_EXEMPT_REASON='Installation profile contains only repository-owned documentation and exact dependency metadata; it imports no third-party source.'
