PACKAGE_DEPENDS='libevent (= 2.1.12-1), libncursesw (= 6.4-20230603-1)'
PACKAGE_BUILD_DEPENDS='libevent libncursesw'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'
SOURCE_REPOSITORY='https://github.com/tmux/tmux'
