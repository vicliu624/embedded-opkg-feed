PACKAGE='vicliu624-lofibox-widget'
VERSION='0.3.4-1'
PACKAGE_ARCH='riscv64'
MAINTAINER='Vic Li <vicliu@outlook.com>'
DESCRIPTION='LoFiBox Zero Wayland layer-shell music widget for the TDVP K230 desktop'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='sound'
PACKAGE_RELEASES='r7'

# These are the widget's direct, independently owned non-ABI runtimes.  The
# auto-derived closure below verifies these declarations against the actual
# target ELF and adds any future direct SONAME without allowing it to borrow a
# coincidental base-image library.  The data providers make its menu entry,
# icon and MIME declaration visible after installation.
PACKAGE_DEPENDS='libwayland-client-0 (= 2025.02.1-1), libxkbcommon-0 (= 2025.02.1-1), libfreetype-6 (= 2025.02.1-1), hicolor-icon-theme (= 2025.02.1-1), shared-mime-info (= 2025.02.1-1)'
PACKAGE_BUILD_DEPENDS=''
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

# The build hook rejects a checkout whose remote, commit or content differs
# from this source lock.
SOURCE_REPOSITORY='https://github.com/vicliu624/LoFiBox-Zero'
SOURCE_REVISION='afe4136adf85a6fb891d22460d329c0783ec657a'
BUILD_ENVIRONMENT='protected-tdvp-k230-sdk'
