PACKAGE='wget'
VERSION='1.25.0-2'
PACKAGE_ARCH='riscv64'
MAINTAINER='TDVP Device Team <devices@example.invalid>'
DESCRIPTION='GNU Wget HTTPS download command for TDVP K230'
SUPPORTED_PLATFORMS='tdvp-k230-r1'
PACKAGE_KIND='application'
PACKAGE_SECTION='net'
PACKAGE_RELEASES='r10'
PACKAGE_DEPENDS='ca-certificates (= 2025.02.1-1), libssl-3 (= 3.4.1-1), libcrypto-3 (= 3.4.1-1), libz (= 1.3.1-1)'
PACKAGE_BUILD_DEPENDS='ca-certificates libssl-3 libcrypto-3 libz'
PACKAGE_AUTO_RUNTIME_DEPENDS=1
PACKAGE_BASE_OVERLAY='deny'

SOURCE_REPOSITORY='https://www.gnu.org/software/wget/'
SOURCE_REVISION='1.25.0'
SOURCE_ARCHIVE='wget-1.25.0.tar.lz'
SOURCE_ARCHIVE_SHA256='19225cc756b0a088fc81148dc6a40a0c8f329af7fd8483f1c7b2fe50f4e08a1f'
