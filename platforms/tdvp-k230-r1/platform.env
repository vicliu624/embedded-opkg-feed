# Binary compatibility contract for the currently supported TDVP firmware
# image.  Application-specific tools, including LoFiBox's ffprobe worker,
# belong in the feed rather than changing this base-image ABI.
# This file belongs to the firmware-release boundary, not to an individual app.

PLATFORM_SLUG='tdvp-k230-r1'
PLATFORM_ID='tdvp-k230-br2025.02.1-glibc2.33-rv64-lp64d-k6.6.36-r1'
ARCH='riscv64'
ABI_PACKAGE='tdvp-platform-abi'
ABI_VERSION='2025.02.1-k230.6.6.36-glibc2.33-rv64-lp64d-r1'
OFFICIAL_PACKAGE_PREFIX='tdvp-'

# r1 is the firmware ABI identifier.  The immutable feed release is a
# separate delivery namespace; new catalogues use an additional URL segment
# rather than pretending a package-only update changed the running firmware.
DEFAULT_FEED_RELEASE='r7'

# Devices retain this ABI-specific channel URL while a reviewed release
# promotion advances its signed immutable snapshot.
DEVICE_FEED_CHANNEL='stable'

# The target-derived catalogue version is distinct from the firmware ABI and
# from the immutable feed publication revision.  Every generated runtime
# package uses it in an exact Depends relation.
RUNTIME_CATALOG_VERSION='2025.02.1-1'

# The r11 runtime catalogue is built against the released image's ownership
# inventory.  CI may reuse a pre-fakeroot SDK cache, whose target/ has no
# image-base.json, so this immutable release asset is a required build input.
IMAGE_OWNERSHIP_MANIFEST_URL='https://github.com/vicliu624/t-display-k230-vision-platform/releases/download/v2026.09.23-r11/tdvp-image-base.json'
IMAGE_OWNERSHIP_MANIFEST_SHA256='0c0d0f2f4b1a2cb5e1278939bc17143f2b76b5654e26dc1648b274ba41f79cb6'

# Published CPU0 package-build SDK, paired with the final r11 image.
SDK_RELEASE_URL='https://github.com/vicliu624/t-display-k230-vision-platform/releases/download/v2026.09.23-r11'
SDK_ARCHIVE='tdvp-k230-labwc-desktop-v2026.09.23-r11-cpu0-sdk.tar.gz'
SDK_ARCHIVE_SHA256='43145ab90e678abb459e9cb618ec93fcd82aaa644b0633ddded91184c40941e9'
SDK_MANIFEST_SHA256='ec8e65a0155929affdf154249f71a240a8cc6284eb619160f7bc8ece5328188d'
SDK_IMAGE_ARCHIVE='tdvp-k230-labwc-desktop-v2026.09.23-r11.img.gz'
SDK_IMAGE_SHA256='8a3a5b197e7684e56796a47dcea42df4927aa1a6601ab97dc9d3c6b8432ac9e1'
