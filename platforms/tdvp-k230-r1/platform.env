# Binary compatibility contract for the TDVP image that exposes the complete
# LoFiBox media-tool contract (ffmpeg, ffprobe and native PCM sinks).
# This file belongs to the firmware-release boundary, not to an individual app.

PLATFORM_SLUG='tdvp-k230-r1'
PLATFORM_ID='tdvp-k230-br2025.02.1-glibc2.33-rv64-lp64d-k6.6.36-r2'
ARCH='riscv64'
ABI_PACKAGE='tdvp-platform-abi'
ABI_VERSION='2025.02.1-k230.6.6.36-glibc2.33-rv64-lp64d-r2'
OFFICIAL_PACKAGE_PREFIX='tdvp-'

# r2 is the firmware ABI identifier.  The immutable feed release is a
# separate delivery namespace; new catalogues use an additional URL segment
# rather than pretending a package-only update changed the running firmware.
DEFAULT_FEED_RELEASE='r7'

# The target-derived catalogue version is distinct from the firmware ABI and
# from the immutable feed publication revision.  Every generated runtime
# package uses it in an exact Depends relation.
RUNTIME_CATALOG_VERSION='2025.02.1-1'
