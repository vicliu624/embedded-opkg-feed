config BR2_PACKAGE_TDVP_AUDACIOUS
	bool "tdvp-audacious"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Audacious 4.6.1 core, built only as a transient input to the
	  ABI-matched TDVP K230 feed. It is not installed into the firmware
	  target: the feed build splits its reusable libraries and leaf
	  application into separate IPKs.
