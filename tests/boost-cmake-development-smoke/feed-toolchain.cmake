if(NOT TDVP_SDK_ROOT OR NOT TDVP_FEED_STAGING_ROOT)
  message(FATAL_ERROR "The paired SDK and feed development staging are required")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TDVP_SDK_ROOT TDVP_FEED_STAGING_ROOT)
include("${TDVP_SDK_ROOT}/toolchain.cmake")
list(PREPEND CMAKE_FIND_ROOT_PATH "${TDVP_FEED_STAGING_ROOT}")
list(PREPEND CMAKE_PREFIX_PATH "${TDVP_FEED_STAGING_ROOT}/usr")
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -Wl,-rpath-link,${TDVP_FEED_STAGING_ROOT}/usr/lib")
